# Base URL of the GranthanAI API Gateway (include the /api/v1 prefix).
# The browser only ever talks to the gateway - never to Kafka, Redis, gRPC or internal services.
#
# Use the SAME host name as the page you open (127.0.0.1, not localhost): the gateway sets
# the refresh-token cookie as SameSite=Strict, so page and API must be same-site.
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
