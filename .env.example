# Base URL of the GranthanAI API Gateway (include the /api/v1 prefix).
# The browser only ever talks to the gateway - never to Kafka, Redis, gRPC or internal services.
#
# The gateway sets the refresh-token cookie as SameSite=Strict, so the page and the API must be
# same-site: use the SAME host name for both (127.0.0.1 with 127.0.0.1, or localhost with localhost).
#
# Billing: the payment simulator popup is served from this API origin, and it posts its result back
# to the origin configured as FRONTEND_ORIGIN in billing-service. The page you open must therefore
# be exactly that origin (billing-service .env.dev uses http://localhost:5173), so with billing on
# use  VITE_API_BASE_URL=http://localhost:8080/api/v1  and open  http://localhost:5173.
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Where "Contact support" links go. Leave unset to hide those links.
VITE_SUPPORT_EMAIL=support@granthan.ai
